# Copy to .env and replace every example value. Do not commit .env to GitHub.
# Set this to the VM's IP address on the network your host browser can reach.
VM_LAN_IP=192.168.1.100

MARIADB_DATABASE=wordpress
MARIADB_USER=wp_user
MARIADB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
